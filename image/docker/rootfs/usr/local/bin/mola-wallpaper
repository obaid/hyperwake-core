#!/bin/bash
# Generate the Mola wallpaper at build time, so the image carries no
# binary blob in version control.
#
# Visual direction from docs/founder-pack/06_BRAND_AND_NAMING.md: terminal
# native, black / cream / warm grey, large monospace, subtle grid,
# window-manager geometry.

set -euo pipefail

OUT="${1:-/usr/share/mola/wallpaper.png}"
mkdir -p "$(dirname "${OUT}")"

# Debian ships ImageMagick 6, whose binary is `convert`. ImageMagick 7 renamed
# it to `magick` and deprecated `convert`. Support both rather than pinning the
# image to one distro's packaging.
if command -v magick >/dev/null 2>&1; then
    IM=(magick)
elif command -v convert >/dev/null 2>&1; then
    IM=(convert)
else
    echo "no ImageMagick available; skipping wallpaper" >&2
    exit 0
fi

W=1920
H=1200

BG='#0d0c0b'      # near-black, warm
GRID='#1a1917'    # the grid is felt more than seen
CREAM='#e8e0d4'
AMBER='#d78a3c'
GREY='#5c574f'

# A 40px grid tile, expanded to fill the canvas.
"${IM[@]}" -size 40x40 "xc:${BG}" \
    -stroke "${GRID}" -strokewidth 1 \
    -draw "line 0,0 40,0" \
    -draw "line 0,0 0,40" \
    /tmp/hw-tile.png

"${IM[@]}" -size "${W}x${H}" "tile:/tmp/hw-tile.png" /tmp/hw-base.png

# Pick whichever mono font this base image actually has. A missing font makes
# ImageMagick fall back to something proportional, which looks wrong for a
# terminal-native brand.
FONT=""
for candidate in \
    /usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-Bold.ttf \
    /usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf \
    /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf; do
    if [ -f "${candidate}" ]; then
        FONT="${candidate}"
        break
    fi
done

FONT_ARGS=()
[ -n "${FONT}" ] && FONT_ARGS=(-font "${FONT}")

# Wordmark, plus three tiled panes with one accented — the visual language of
# the product itself.
"${IM[@]}" /tmp/hw-base.png \
    -fill none -stroke "${GREY}" -strokewidth 2 \
    -draw "rectangle 160,760 620,1000" \
    -draw "rectangle 640,760 980,880" \
    -stroke "${AMBER}" \
    -draw "rectangle 640,900 980,1000" \
    -stroke none \
    "${FONT_ARGS[@]}" \
    -fill "${CREAM}" -pointsize 128 \
    -annotate +160+300 "MOLA" \
    -fill "${GREY}" -pointsize 38 \
    -annotate +166+380 "cloud computers for humans and agents" \
    -fill "${AMBER}" -pointsize 32 \
    -annotate +166+470 "dev image - not Omarchy" \
    "${OUT}"

rm -f /tmp/hw-tile.png /tmp/hw-base.png

echo "wallpaper written to ${OUT}"
