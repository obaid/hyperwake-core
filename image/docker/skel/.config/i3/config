# Mola dev image — i3 configuration.
#
# Tuned for a browser-delivered desktop: no compositor, no animations, gaps big
# enough to read at VNC's frame rate, and a bar that tells the customer what
# machine they are actually looking at.

set $mod Mod1

font pango:JetBrains Mono 11

# --- palette -----------------------------------------------------------------
# Warm terminal palette from the brand direction: near-black, cream, amber.
set $bg      #0d0c0b
set $bg_alt  #1a1917
set $fg      #e8e0d4
set $grey    #5c574f
set $amber   #d78a3c
set $red     #c25a4a

# class                 border   backgr.  text    indicator  child_border
client.focused          $amber   $bg_alt  $fg     $amber     $amber
client.focused_inactive $grey    $bg      $grey   $grey      $grey
client.unfocused        $bg_alt  $bg      $grey   $bg_alt    $bg_alt
client.urgent           $red     $red     $fg     $red       $red
client.background       $bg

for_window [class=".*"] border pixel 2

# --- keys --------------------------------------------------------------------
bindsym $mod+Return exec urxvt
bindsym $mod+d exec --no-startup-id i3-dmenu-desktop
bindsym $mod+q kill

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- bar ---------------------------------------------------------------------
bar {
    position top
    status_command i3status -c ~/.config/i3/i3status.conf
    separator_symbol " · "
    strip_workspace_numbers no

    colors {
        background $bg
        statusline $fg
        separator  $grey

        #                  border  backgr. text
        focused_workspace  $amber  $amber  $bg
        active_workspace   $bg_alt $bg_alt $fg
        inactive_workspace $bg     $bg     $grey
        urgent_workspace   $red    $red    $fg
    }
}

# A terminal on login, so the first thing the customer sees when the desktop
# opens is a working machine rather than an empty screen.
exec --no-startup-id urxvt -e /usr/local/bin/mola-welcome
