# Hyperwake guest daemon.
#
# Installed into the real machine image by the Packer build. The development
# container starts the binary from its entrypoint instead.

[Unit]
Description=Hyperwake guest daemon
Documentation=https://hyperwake.ai/docs/guest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hyperwake-guest

# Per-machine configuration is injected at clone time. The image itself carries
# no credentials.
EnvironmentFile=/etc/hyperwake/guest.env

Restart=always
RestartSec=5s

# The daemon needs to read /proc and write its state directory. It needs
# nothing else, so take everything else away.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/hyperwake
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyperwake-guest

[Install]
WantedBy=multi-user.target
