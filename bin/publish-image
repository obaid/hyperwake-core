#!/usr/bin/env python3
"""Package a prepared guest image and publish it where the engine can fetch it.

Takes an image directory built by `native-prepare`, compresses the root
filesystem, writes a manifest naming every artifact with its digest, and
uploads the set to a GitHub release.

    bin/publish-image --image ~/.mola/image --tag image-latest

Nothing is uploaded without --tag, so you can build and inspect the bundle
first. Re-running against an existing tag replaces the assets.
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOTFS = 'root.ext4'
SIDECARS = ('vmlinuz-linux', 'initramfs-linux.img', 'guest-manifest.json',
            'provenance.json', 'packages.lock.txt', 'build-spec.json', 'LICENSE.omarchy')


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def human(n):
    return f'{n / 1024 ** 2:,.0f} MB'


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('--image', type=Path, default=Path.home() / '.mola/image',
                   help='image directory built by native-prepare')
    p.add_argument('--out', type=Path, default=Path('.mola/dist/image'),
                   help='where to stage the bundle')
    p.add_argument('--repo', default='obaid/mola-core')
    p.add_argument('--tag', help='GitHub release tag to upload to; omit to build only')
    p.add_argument('--version', help='version label recorded in the manifest')
    p.add_argument('--part-mb', type=int, default=256,
                   help='split large artifacts into parts of this size (0 to disable)')
    a = p.parse_args()

    image = a.image.resolve()
    rootfs = image / ROOTFS
    if not rootfs.is_file():
        sys.exit(f'No {ROOTFS} in {image}. Build one with bin/native-prepare first.')

    if not shutil.which('zstd'):
        sys.exit('zstd is required to compress the root filesystem. `brew install zstd`.')

    out = a.out.resolve()
    out.mkdir(parents=True, exist_ok=True)

    # The engine grows the filesystem back to this size after decompressing, so
    # a machine never finds a disk smaller than the image claims.
    sparse_bytes = rootfs.stat().st_size

    version = a.version
    if not version:
        manifest_path = image / 'guest-manifest.json'
        if manifest_path.is_file():
            # The Omarchy release lives under `upstream`; `guest` carries the
            # architecture and display geometry, not a version.
            data = json.loads(manifest_path.read_text())
            release = data.get('upstream', {}).get('release', 'unknown')
            arch = data.get('guest', {}).get('architecture', 'unknown')
            version = f'omarchy-{release}-{arch}'
        else:
            version = 'unknown'

    compressed = out / f'{ROOTFS}.zst'
    if compressed.exists():
        print(f'Reusing {compressed.name}')
    else:
        print(f'Compressing {ROOTFS} ({human(sparse_bytes)} sparse)...', flush=True)
        subprocess.run(['zstd', '-3', '-T0', '-q', str(rootfs), '-o', str(compressed)], check=True)

    base = f'https://github.com/{a.repo}/releases/download/{a.tag or "TAG"}'

    # A single multi-gigabyte upload is the least reliable step in the chain,
    # and a failed download of one costs the whole thing. Parts fix both.
    part_bytes = a.part_mb * 1024 * 1024
    uploads = []
    rootfs_artifact = {
        'name': ROOTFS,
        'sha256': digest(compressed),
        'bytes': compressed.stat().st_size,
        'compression': 'zstd',
        'sparse_bytes': sparse_bytes,
    }
    if part_bytes and rootfs_artifact['bytes'] > part_bytes:
        for old_part in out.glob(f'{ROOTFS}.zst.part*'):
            old_part.unlink()
        parts = []
        with compressed.open('rb') as source:
            index = 0
            while True:
                chunk = source.read(part_bytes)
                if not chunk:
                    break
                name = f'{ROOTFS}.zst.part{index:03d}'
                (out / name).write_bytes(chunk)
                parts.append({'url': f'{base}/{name}', 'bytes': len(chunk)})
                uploads.append(str(out / name))
                index += 1
        rootfs_artifact['parts'] = parts
        print(f'Split into {len(parts)} parts of up to {a.part_mb} MB')
    else:
        rootfs_artifact['url'] = f'{base}/{ROOTFS}.zst'
        uploads.append(str(compressed))

    artifacts = [rootfs_artifact]

    for name in SIDECARS:
        source = image / name
        if not source.is_file():
            continue
        target = out / name
        if not target.exists() or target.stat().st_mtime < source.stat().st_mtime:
            shutil.copy2(source, target)
        artifacts.append({
            'name': name,
            'url': f'{base}/{name}',
            'sha256': digest(target),
            'bytes': target.stat().st_size,
        })

    manifest = {'version': version, 'artifacts': artifacts}
    (out / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')

    # The same bundle addressed by bare filename. The engine resolves artifact
    # URLs against the manifest it fetched, so this one works from wherever the
    # directory is served: a local http server while testing, a mirror, a USB
    # stick. The published manifest keeps absolute release URLs, because an
    # engine older than that resolving step still has to be able to read it.
    def relative(artifact):
        copy = dict(artifact)
        if 'url' in copy:
            copy['url'] = copy['url'].rsplit('/', 1)[-1]
        if 'parts' in copy:
            copy['parts'] = [{**part, 'url': part['url'].rsplit('/', 1)[-1]}
                             for part in copy['parts']]
        return copy

    (out / 'manifest.local.json').write_text(
        json.dumps({'version': version, 'artifacts': [relative(a) for a in artifacts]}, indent=2) + '\n')

    total = sum(x['bytes'] for x in artifacts)
    print(f'\nBundle ready in {out}')
    for x in artifacts:
        print(f'  {x["name"]:<24} {human(x["bytes"]):>10}')
    print(f'  {"total download":<24} {human(total):>10}')

    if not a.tag:
        print('\nNo --tag given, so nothing was uploaded.')
        print(f'Test it locally:\n  (cd {out} && python3 -m http.server 8910)')
        print('  MOLA_IMAGE_URL=http://127.0.0.1:8910/manifest.local.json npx mola-core')
        return

    if not shutil.which('gh'):
        sys.exit('The GitHub CLI is required to upload. https://cli.github.com')

    # The manifest goes last. It names every other file, so uploading it first
    # leaves a window in which the release advertises parts that have not
    # arrived, and that window is exactly what a fresh install would fetch.
    assets = uploads + \
             [str(out / x['name']) for x in artifacts if x['name'] != ROOTFS] + \
             [str(out / 'manifest.json')]

    existing = subprocess.run(['gh', 'release', 'view', a.tag, '--repo', a.repo],
                              capture_output=True, text=True)
    if existing.returncode != 0:
        print(f'\nCreating release {a.tag}...')
        subprocess.run(['gh', 'release', 'create', a.tag, '--repo', a.repo,
                        '--title', f'Guest image {version}', '--notes',
                        f'Prebuilt Omarchy guest image ({version}). Fetched automatically on first run.\n\n'
                        f'Total download {human(total)}. Artifacts and digests are in manifest.json.'],
                       check=True)

    # One at a time, with retries. A single `gh release upload` of the whole
    # set is atomic in neither direction: a network failure part way through
    # leaves some assets replaced and some missing, and since --clobber deletes
    # before it uploads, a failed part is a part that is simply gone. That
    # happened on a `tls: bad record MAC` and left the published release
    # advertising six parts it did not have.
    def uploaded_size(name):
        """What the release actually holds, which is the only thing that counts."""
        result = subprocess.run(['gh', 'release', 'view', a.tag, '--repo', a.repo,
                                 '--json', 'assets'], capture_output=True, text=True)
        if result.returncode != 0:
            return None
        for item in json.loads(result.stdout).get('assets', []):
            if item['name'] == name:
                return item['size']
        return None

    print(f'Uploading {len(assets)} assets to {a.tag}...', flush=True)
    for asset in assets:
        name = Path(asset).name
        expected = Path(asset).stat().st_size
        for attempt in range(1, 5):
            subprocess.run(['gh', 'release', 'upload', a.tag, '--repo', a.repo,
                            '--clobber', asset], capture_output=True, text=True)
            # Confirmed against the release rather than against an exit code.
            # A partial upload is the failure that matters here, and it is the
            # one an exit code is least likely to tell you about.
            if uploaded_size(name) == expected:
                print(f'  {name}', flush=True)
                break
            if attempt == 4:
                sys.exit(f'\n{name} did not reach the release after 4 attempts.\n'
                         'The release is now incomplete, so nothing can install from '
                         'it. Re-run this command; it is safe to repeat and replaces '
                         'whatever is there.')
            print(f'  {name} attempt {attempt} failed, retrying', flush=True)
            time.sleep(attempt * 5)

    print(f'\nPublished. The engine will fetch:\n  {base}/manifest.json')
    print('\nRelease assets on a private repository need authentication to')
    print('download, so npx mola-core can only fetch these once the repository')
    print('is public, or if MOLA_IMAGE_URL points somewhere else.')


if __name__ == '__main__':
    main()
